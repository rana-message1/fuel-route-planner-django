# Copy to .env and adjust. Every value has a sensible default except
# DJANGO_SECRET_KEY, which is required when DJANGO_DEBUG is false.

# --- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to true when deployed behind HTTPS (secure cookies, HSTS, SSL redirect)
DJANGO_SECURE_HTTPS=false
# SQLITE_PATH=/absolute/path/to/db.sqlite3
APP_LOG_LEVEL=INFO
# Anonymous request throttle (protects the free routing API)
API_THROTTLE_RATE=60/minute

# --- Routing --------------------------------------------------------------
# "osrm" (default, no API key) or "openrouteservice" (free key: https://openrouteservice.org/dev/#/signup)
ROUTING_PROVIDER=osrm
ROUTING_TIMEOUT_SECONDS=20
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# driving-car or driving-hgv (heavy goods vehicle routing)
ORS_PROFILE=driving-car
# Seconds a computed route is re-used for identical start/finish coordinates
ROUTE_CACHE_SECONDS=86400

# --- Geocoding fallback (only for input the local Census table can't resolve) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent; include a contact.
GEOCODER_USER_AGENT=fuel-route-planner/1.0 (you@example.com)
GEOCODING_TIMEOUT_SECONDS=10
GEOCODING_CACHE_SECONDS=604800

# --- Vehicle and optimisation --------------------------------------------
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
STATION_SEARCH_RADIUS_MILES=10
ROUTE_SAMPLE_INTERVAL_MILES=1
# A stop is kept only if it saves more than this many dollars (0 = pure minimum cost)
MIN_SAVINGS_PER_STOP_USD=1.00
